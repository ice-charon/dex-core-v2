;; messages from admin

(int) handle_ext_router_messages() impure inline {
    slice in_msg_body = ctx.at(BODY);

    if ctx.at(OPCODE) == op::internal_set_params {
        slice resp = in_msg_body~load_msg_addr();
        slice fees = in_msg_body~load_slice_ref();
        slice usd_rate = in_msg_body~load_slice_ref();
        slice swap_side = in_msg_body~load_slice_ref();
        slice swap_address = in_msg_body~load_slice_ref();

        if (fees.slice_empty?() == 0) {
            storage::bc_lp_fee = fees~load_uint(16);
            storage::bc_protocol_fee = fees~load_uint(16);
        }

        if (usd_rate.slice_empty?() == 0) {
            storage::base_usd_rate = usd_rate~load_uint(<%= calcBaseUSDRateSize %>);
        }

        if (swap_side.slice_empty?() == 0) {
            storage::swap_side = swap_side~load_bool();
        }

        if (swap_address.slice_empty?() == 0) {
            storage::bc_swap_address = swap_address~load_msg_addr();
        }

        storage::save();

        reserves::max_balance(storage_fee::pool);
        utils::send_excesses(0, resp, QCARRY_ALL_BALANCE);

        return (true);
    }

    return (false);
}
